{
  "name": "material-foundry-desktop",
  "productName": "Material Foundry",
  "version": "1.0.0",
  "description": "Material Foundry — textures, 3D models and \"Understand code without fear\" (learning, Workshop, Mini-Unity). Works offline.",
  "author": "Material Foundry",
  "license": "MIT",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare-app": "node prepare-app.cjs",
    "start": "npm run prepare-app && electron .",
    "dist:win": "npm run prepare-app && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run prepare-app && electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "app.materialfoundry.desktop",
    "productName": "Material Foundry",
    "copyright": "Material Foundry",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "server.cjs",
      "package.json",
      "app/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "MaterialFoundry-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Material Foundry",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "language": "1049",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "license": "build/license.txt"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Education"
    },
    "publish": null
  }
}
