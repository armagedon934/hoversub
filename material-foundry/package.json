{
  "name": "material-foundry",
  "private": true,
  "version": "1.0.0",
  "description": "Browser-based procedural material and seamless texture studio",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "tsx scripts/e2e.ts",
    "examples": "tsx scripts/make-examples.ts",
    "e2e:4096": "tsx scripts/e2e-4096.ts",
    "e2e:glb": "tsx scripts/e2e-glb.ts",
    "e2e:code": "tsx scripts/e2e-code.ts",
    "package": "npm run build && python3 scripts/package_portable.py",
    "e2e:workshop": "tsx scripts/e2e-workshop.ts",
    "e2e:shooter": "tsx scripts/e2e-shooter.ts",
    "e2e:desktop": "tsx scripts/e2e-desktop.ts",
    "desktop:win": "npm run build && cd desktop && npm install && npm run dist:win"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource/pt-sans": "5.2.8",
    "@lezer/highlight": "1.2.5",
    "fflate": "0.8.3",
    "lucide-react": "0.544.0",
    "pyodide": "314.0.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.186.1",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
